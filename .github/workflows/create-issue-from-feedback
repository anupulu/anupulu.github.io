name: Create Issue from Feedback

on:
  workflow_dispatch:
    inputs:
      label:
        description: 'Issue Label (Bug or Idea)'
        required: true
        default: 'Idea'
      description:
        description: 'Tell me more field description'
        required: true
        default: 'Provide a detailed description'

jobs:
  create-issue:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v2

      - name: Parse form data
        id: parse_form_data
        run: |
          echo "::set-output name=body::${{ github.event.inputs.description }}"
          echo "::set-output name=label::${{ github.event.inputs.label }}"

      - name: Create Issue
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          curl -X POST -H "Authorization: token $GITHUB_TOKEN" -H "Accept: application/vnd.github.v3+json" \
          https://api.github.com/repos/${{ github.repository }}/issues \
          -d '{"title": "Feedback Submission", "body": "${{ steps.parse_form_data.outputs.body }}", "labels": ["${{ steps.parse_form_data.outputs.label }}"]}'

      - name: Log result
        run: echo "Issue created successfully"
        continue-on-error: true
