name: Create Issue from Feedback

on:
  workflow_dispatch:
  # You can add other triggers as needed

jobs:
  create-issue:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v2

      - name: Create Issue
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          curl -X POST -H "Authorization: token $GITHUB_TOKEN" -H "Accept: application/vnd.github.v3+json" \
          https://api.github.com/repos/${{ github.repository }}/issues \
          -d '{"title": "Feedback Submission", "body": "${{ steps.parse_form_data.outputs.body }}", "labels": ["${{ steps.parse_form_data.outputs.label }}"]}'
